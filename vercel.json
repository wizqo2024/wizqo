
{
  "version": 2,
  "buildCommand": "npm run vercel-build && npm run build:server",
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "dist/server/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...path].ts" },
    { "source": "/blog/:slug", "destination": "/index.html" },
    { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
  ]
}
