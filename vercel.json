{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "dist/server/**"
    }
  },
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.wizqo.com" }], "destination": "https://wizqo.com/:path*", "permanent": true },
    {
      "source": "/blog",
      "has": [ { "type": "query", "key": "post" } ],
      "destination": "/blog/:post",
      "permanent": true
    },
    { "source": "/printables/math", "destination": "/printables", "permanent": true },
    { "source": "/printables/math/grade-2", "destination": "/printables", "permanent": true },
    { "source": "/handwriting-worksheet-maker", "destination": "/worksheets/handwriting-worksheet-maker", "permanent": true },
    { "source": "/handwriting-worksheet-maker/", "destination": "/worksheets/handwriting-worksheet-maker", "permanent": true },
    { "source": "/worksheets", "destination": "/worksheets/2nd-grade-math-worksheets", "permanent": true },
    { "source": "/worksheets/", "destination": "/worksheets/2nd-grade-math-worksheets", "permanent": true }
  ],
  "headers": [
    {
      "source": "/print",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/blog/test-markdown-post",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...path].ts" },
    { "source": "/kids", "destination": "/kids/index.html" },
    { "source": "/kids/games/memory", "destination": "/kids/games/memory/index.html" },
    { "source": "/kids/games/word-search", "destination": "/kids/games/word-search/index.html" },
    { "source": "/kids/games/puzzle", "destination": "/kids/games/puzzle/index.html" },
    { "source": "/kids/games/typing", "destination": "/kids/games/typing/index.html" },
    { "source": "/kids/games/pattern", "destination": "/kids/games/pattern/index.html" },
    { "source": "/printables", "destination": "/printables/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/worksheets/1st-grade-math-worksheets", "destination": "/worksheets/1st-grade-math-worksheets/index.html" },
    { "source": "/worksheets/2nd-grade-math-worksheets", "destination": "/worksheets/2nd-grade-math-worksheets/index.html" },
    { "source": "/interactive-worksheets-generator", "destination": "/interactive-worksheets-generator/index.html" },
    { "source": "/generate", "destination": "/generate/index.html" },
    { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
  ]
}
