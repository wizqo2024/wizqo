{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "dist/server/**"
    }
  },
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.wizqo.com" }], "destination": "https://wizqo.com/:path*", "permanent": true },
    {
      "source": "/blog",
      "has": [ { "type": "query", "key": "post" } ],
      "destination": "/blog/:post",
      "permanent": true
    },
    { "source": "/printables/math", "destination": "/printables", "permanent": true },
    { "source": "/printables/math/grade-2", "destination": "/printables", "permanent": true },
    { "source": "/handwriting-worksheet-maker", "destination": "/worksheets/handwriting-worksheet-maker", "permanent": true },
    { "source": "/handwriting-worksheet-maker/", "destination": "/worksheets/handwriting-worksheet-maker", "permanent": true },
    { "source": "/worksheets", "destination": "/worksheets/2nd-grade-math-worksheets", "permanent": true },
    { "source": "/worksheets/", "destination": "/worksheets/2nd-grade-math-worksheets", "permanent": true }
  ],
  "headers": [
    {
      "source": "/print",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/blog/test-markdown-post",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...path].ts" },
    { "source": "/:locale(es|ar)/kids", "destination": "/kids/index.html" },
    { "source": "/:locale(es|ar)/kids/games/memory", "destination": "/kids/games/memory/index.html" },
    { "source": "/:locale(es|ar)/kids/games/word-search", "destination": "/kids/games/word-search/index.html" },
    { "source": "/:locale(es|ar)/kids/games/puzzle", "destination": "/kids/games/puzzle/index.html" },
    { "source": "/:locale(es|ar)/kids/games/typing", "destination": "/kids/games/typing/index.html" },
    { "source": "/:locale(es|ar)/kids/games/pattern", "destination": "/kids/games/pattern/index.html" },
    { "source": "/:locale(es|ar)/printables", "destination": "/printables/index.html" },
    { "source": "/:locale(es|ar)/printables/name-tracing-generator", "destination": "/printables/name-tracing-generator/index.html" },
    { "source": "/:locale(es|ar)/printables/certificate-maker", "destination": "/printables/certificate-maker/index.html" },
    { "source": "/:locale(es|ar)/blog", "destination": "/blog/index.html" },
    { "source": "/:locale(es|ar)/blog/([^/]+)", "destination": "/blog/$1/index.html" },
    { "source": "/:locale(es|ar)/worksheets/1st-grade-math-worksheets", "destination": "/worksheets/1st-grade-math-worksheets/index.html" },
    { "source": "/:locale(es|ar)/worksheets/2nd-grade-math-worksheets", "destination": "/worksheets/2nd-grade-math-worksheets/index.html" },
    { "source": "/:locale(es|ar)/worksheets/handwriting-worksheet-maker", "destination": "/worksheets/handwriting-worksheet-maker/index.html" },
    { "source": "/:locale(es|ar)/worksheets/reading-comprehension", "destination": "/worksheets/reading-comprehension/index.html" },
    { "source": "/:locale(es|ar)/worksheets/multiplication-worksheets", "destination": "/worksheets/multiplication-worksheets/index.html" },
    { "source": "/:locale(es|ar)/worksheets/times-table-multiplication-worksheets", "destination": "/worksheets/times-table-multiplication-worksheets/index.html" },
    { "source": "/:locale(es|ar)/worksheets/kindergarten-math-worksheets", "destination": "/worksheets/kindergarten-math-worksheets/index.html" },
    { "source": "/:locale(es|ar)/worksheets/3rd-grade-math-worksheets", "destination": "/worksheets/3rd-grade-math-worksheets/index.html" },
    { "source": "/:locale(es|ar)/worksheets/4th-grade-math-worksheets", "destination": "/worksheets/4th-grade-math-worksheets/index.html" },
    { "source": "/:locale(es|ar)/worksheets/5th-grade-math-worksheets", "destination": "/worksheets/5th-grade-math-worksheets/index.html" },
    { "source": "/:locale(es|ar)/interactive-worksheets-generator", "destination": "/interactive-worksheets-generator/index.html" },
    { "source": "/:locale(es|ar)/generate", "destination": "/generate/index.html" },
    { "source": "/:locale(es|ar)/about", "destination": "/about/index.html" },
    { "source": "/:locale(es|ar)/contact", "destination": "/contact/index.html" },
    { "source": "/:locale(es|ar)/privacy", "destination": "/privacy/index.html" },
    { "source": "/:locale(es|ar)/terms", "destination": "/terms/index.html" },
    { "source": "/:locale(es|ar)/cookies", "destination": "/cookies/index.html" },
    { "source": "/:locale(es|ar)/((?!assets/|api/).*)", "destination": "/index.html" },
    { "source": "/kids", "destination": "/kids/index.html" },
    { "source": "/kids/games/memory", "destination": "/kids/games/memory/index.html" },
    { "source": "/kids/games/word-search", "destination": "/kids/games/word-search/index.html" },
    { "source": "/kids/games/puzzle", "destination": "/kids/games/puzzle/index.html" },
    { "source": "/kids/games/typing", "destination": "/kids/games/typing/index.html" },
    { "source": "/kids/games/pattern", "destination": "/kids/games/pattern/index.html" },
    { "source": "/printables", "destination": "/printables/index.html" },
    { "source": "/printables/name-tracing-generator", "destination": "/printables/name-tracing-generator/index.html" },
    { "source": "/printables/certificate-maker", "destination": "/printables/certificate-maker/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/([^/]+)", "destination": "/blog/$1/index.html" },
    { "source": "/worksheets/1st-grade-math-worksheets", "destination": "/worksheets/1st-grade-math-worksheets/index.html" },
    { "source": "/worksheets/2nd-grade-math-worksheets", "destination": "/worksheets/2nd-grade-math-worksheets/index.html" },
    { "source": "/worksheets/handwriting-worksheet-maker", "destination": "/worksheets/handwriting-worksheet-maker/index.html" },
    { "source": "/worksheets/reading-comprehension", "destination": "/worksheets/reading-comprehension/index.html" },
    { "source": "/worksheets-1", "destination": "/worksheets-1/index.html" },
    { "source": "/interactive-worksheets-generator", "destination": "/interactive-worksheets-generator/index.html" },
    { "source": "/generate", "destination": "/generate/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/cookies", "destination": "/cookies/index.html" },
    { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
  ]
}
