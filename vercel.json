
{
  "version": 2,
  "functions": {
    "api/[...path].ts": {
      "runtime": "@vercel/node@3.0.0",
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...path].ts" },
    { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
  ]
}
